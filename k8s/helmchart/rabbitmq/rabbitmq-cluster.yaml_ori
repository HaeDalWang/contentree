apiVersion: rabbitmq.com/v1beta1
kind: RabbitmqCluster
metadata:
    name: rabbitmq-node
spec:
  service:
    type: NodePort
  override:
    service:
      spec:
        ports:
          - name: http
            protocol: TCP
            port: 15672
            targetPort: 15672
            nodePort: 31672
          - name: amqp
            protocol: TCP
            port: 5672
            targetPort: 5672
            nodePort: 30672
  replicas: 3
  persistence:
    #storageClassName: "gp2"
    storage: 2Gi
  resources:
    limits:
      cpu: "2"
      memory: 4Gi
    requests:
      cpu: "0.25"
      memory: 2Gi
  rabbitmq:
    additionalConfig: |
      log.console.level = info
      cluster_partition_handling = pause_minority
      vm_memory_high_watermark_paging_ratio = 0.99
      disk_free_limit.relative = 1.0
    envConfig: |
      RABBITMQ_DEFAULT_USER=runable
      RABBITMQ_DEFAULT_PASS=Rabbit123!$@#
      RABBITMQ_NODE_PORT=5672
    additionalPlugins:
      - rabbitmq_top
      - rabbitmq_shovel
      - rabbitmq_management
      - rabbitmq_peer_discovery_k8s
      - rabbitmq_stomp
      - rabbitmq_prometheus


